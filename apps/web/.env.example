# Web (Next.js) Environment Variables

# Public-facing URL of the API. Used in the browser, so must be reachable
# from the user's device (not just from the Next.js server).
NEXT_PUBLIC_API_URL=http://localhost:3010

# Optional internal-only URL used by Server Components / route handlers when
# they call the API. Falls back to NEXT_PUBLIC_API_URL when unset.
INTERNAL_API_URL=http://localhost:3010

# Shared secret used by the on-demand ISR webhook at /api/revalidate.
# MUST exactly match the API's REVALIDATE_SECRET. >= 32 chars recommended.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
