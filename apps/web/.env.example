# Web (Next.js) Environment Variables
#
# Copy to apps/web/.env.local for development. Production values live in
# apps/web/.env.production (already committed for the live site).
#
# NEXT_PUBLIC_* values are compiled into the browser bundle — never put a
# secret in one.

### API location
# Public-facing URL of the API. Used in the browser, so it must be reachable
# from the user's device (not just from the Next.js server).
#
# Leave it UNSET in production: the app then calls the relative path "/api",
# which Nginx proxies to the API on the same domain. That keeps cookies
# first-party and avoids CORS entirely.
NEXT_PUBLIC_API_URL=http://localhost:3005

# Optional internal-only URL used by Server Components / route handlers when
# they call the API. Falls back to NEXT_PUBLIC_API_URL when unset.
INTERNAL_API_URL=http://localhost:3005

### Canonical site URL (SEO)
# Used for metadataBase, canonical tags, sitemaps, JSON-LD and Open Graph URLs.
# Both are read in different places; set them to the same value. No trailing
# slash. Defaults to https://propertydealer.pk when unset.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

### IndexNow (optional)
# Key used when pinging Bing / Yandex about new and updated pages. It must
# match BOTH the API's INDEXNOW_KEY and the key file served at
# apps/web/public/<key>.txt — the search engines fetch that file to verify
# the ping is yours.
#
# The live key file is apps/web/public/8837ca2e8f774e069922248ec058f3ae.txt,
# which is also the built-in fallback. If you change the key, add the new .txt
# file before changing this value.
NEXT_PUBLIC_INDEXNOW_KEY=

### ISR revalidation webhook
# Shared secret used by the on-demand ISR webhook at /api/revalidate.
# MUST exactly match the API's REVALIDATE_SECRET. >= 32 chars recommended.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

### Sign in with Google
# Nothing to configure here. The button is rendered only when the API reports
# that Google is set up (GET /api/auth/providers), so the client ID and secret
# stay server-side in apps/api/.env — which is where they belong.
