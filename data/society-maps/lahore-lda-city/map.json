 "seo": {
  "metaTitle": "LDA City Lahore Map — LDA Layout Plan on Satellite (Jinnah & Iqbal Sector)",
  "metaDescription": "LDA City Lahore layout plan (LDA, February 2023) on the satellite map: Jinnah Sector and Iqbal Sector blocks, Indus Road, Jhelum Road, Chenab Road, Fatima Jinnah Park, the golf course and the Ferozepur Road entrance.",
  "intro": "LDA City Lahore layout plan, February 2023 — the Lahore Development Authority's own plan of the Jinnah Sector and Iqbal Sector, Indus Road and Jhelum Road (300 ft), Chenab Road, Fatima Jinnah Park, the Quaid-e-Azam Golf Course, the Allama Iqbal Sports Complex and the Naya Pakistan Apartments — laid on the satellite map between the Ring Road and Ferozepur Road. See the properties listed in LDA City and find a plot on site with your live location.",
  "content": "<p>This is the LDA's layout plan of February 2023. Parts of the scheme are still being acquired and developed; the LDA confirms a file's block and plot position.</p>"
 },
 "faqs": [
  {
   "q": "Where is LDA City Lahore?",
